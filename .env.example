# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Вход в веб-форму (обязателен, если сервер доступен по сети) ---
WEB_USER=
WEB_PASSWORD=
# Если вход выполняет прокси с единым входом, укажите заголовок с именем пользователя вместо пары выше:
# WEB_USER_HEADER=X-Forwarded-User
# Ключ подписи сообщений формы (любая длинная случайная строка)
WEB_SECRET=

# --- Jira (только чтение). Нужны для check-jira, reconcile и подсказок в форме ---
JIRA_URL=
JIRA_TOKEN=
# или вместо токена:
# JIRA_USER=
# JIRA_PASSWORD=
# Сертификат внутреннего удостоверяющего центра (путь внутри контейнера, файл положите в work/config/):
# JIRA_CA_BUNDLE=/data/config/ca.pem

# --- Владелец файлов в папке ./work (узнать свои значения: id -u и id -g) ---
# APP_UID=10001
# APP_GID=10001

# --- Необязательные пути (внутри контейнера) ---
# ALLOC_DB=out/allocation.sqlite
# ALLOC_ROSTER=config/employees.csv
# ALLOC_PROJECT_MAP=config/jira_project_map.csv
# ALLOC_JIRA_DIR=out/jira
# WEB_PORT=8000
